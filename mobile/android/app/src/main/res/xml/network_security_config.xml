<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />

    <!-- Yerel geliştirme (HTTP) — yalnızca dart-define ile API_BASE_URL=http://... -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>

    <!-- HTTPS enforcement: cleartext traffic disabled globally -->
    <domain-config cleartextTrafficPermitted="false">
        <!-- API domain: HTTPS only -->
        <domain includeSubdomains="true">api.aidatpanel.com</domain>
    </domain-config>

    <!-- Certificate pinning (optional, for future hardening) -->
    <!-- <domain-config>
        <domain includeSubdomains="true">api.aidatpanel.com</domain>
        <pin-set expiration="2027-12-31">
            <pin digest="SHA-256">AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=</pin>
        </pin-set>
    </domain-config> -->
</network-security-config>
