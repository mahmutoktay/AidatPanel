<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />

    <!-- Yerel geliştirme (HTTP) — yalnızca dart-define ile API_BASE_URL=http://... -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>

    <!-- HTTPS enforcement: cleartext traffic disabled globally -->
    <domain-config cleartextTrafficPermitted="false">
        <!-- API domain: HTTPS only -->
        <domain includeSubdomains="true">api.aidatpanel.com</domain>
    </domain-config>

    <!-- Certificate pinning runtime'da DioClient + certificate_pinning.dart ile yapılır.
         CERT_PIN_SHA256 boş bırakılırsa pin kontrolü atlanır. -->
</network-security-config>
