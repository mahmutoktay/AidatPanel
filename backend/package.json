{
  "name": "aidatpanel",
  "version": "1.0.0",
  "description": "Türk apartman ve site yöneticileri için aidat yönetim platformunun Node.js API'si (Express 5, Prisma 7, PostgreSQL).",
  "main": "index.js",
  "scripts": {
    "dev": "nodemon index.js",
    "start": "node index.js",
    "demo:notifications": "node src/scripts/notificationDemo.js",
    "test:push": "node scripts/send-test-push.mjs",
    "test:sms": "node scripts/send-test-sms.mjs",
    "test:verify": "node scripts/send-test-verify.mjs",
    "diagnose:twilio": "node scripts/diagnose-twilio.mjs",
    "test:email-otp": "node scripts/send-test-email-otp.mjs",
    "verify:firebase": "node scripts/diagnose-fcm.mjs",
    "diagnose:fcm": "node scripts/diagnose-fcm.mjs",
    "test:dekont-regex": "node tools/parseDekontSamples.js",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watch",
    "seed:admin": "node scripts/seed-admin.js",
    "seed:showcase": "node scripts/seed-showcase-demo.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@prisma/adapter-neon": "^7.8.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^7.4.0",
    "express-request-id": "^3.0.0",
    "file-type": "^19.6.0",
    "firebase-admin": "^13.0.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.1.1",
    "pdfjs-dist": "^4.0.379",
    "pdfkit": "^0.16.0",
    "pg": "^8.20.0",
    "pino": "^9.3.2",
    "pino-pretty": "^11.2.2",
    "sharp": "^0.33.5",
    "ws": "^8.18.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.1.14",
