PORT=4200
# Geliştirmede "development", canlı sunucuda (VPS) mutlaka "production"
# development modunda SMS gönderilmez; OTP yalnızca sunucu loguna yazılır (sms_dev_skip).
NODE_ENV=development

# Yerel PostgreSQL
#
# Docker (proje kökü — önerilen):
#   cd /path/to/Deneme && docker compose up -d
#   cd backend && cp .env.example .env   # DATABASE_URL satırını aşağıdaki ile değiştir
#   npx prisma migrate deploy && npm run dev
#
DATABASE_URL="postgresql://aidatpanel:aidatpanel@127.0.0.1:5433/aidatpanel?schema=public"

# En az 32 karakter rastgele string (ör. openssl rand -base64 32)
JWT_SECRET=your_jwt_secret_key_here_minimum_32_characters_long
REFRESH_TOKEN_SECRET=your_refresh_token_secret_key_here_minimum_32_characters_long
JWT_EXPIRES_IN="15m"
REFRESH_TOKEN_EXPIRES_IN="30d"

# Virgülle ayrılmış origin listesi (Flutter web veya tarayıcıdan API testi).
# Android/iOS native isteklerde tarayıcı CORS’u yoktur; yalnızca web build için gerekir.
# ALLOWED_ORIGINS=http://localhost:3000,http://localhost:4200,http://localhost:4300,https://admin.aidatpanel.com

# Email Service - Resend (şifre sıfırlama e-postası)
# RESEND_API_KEY=re_xxxxxxxx
# RESEND_FROM_EMAIL="AidatPanel <onboarding@resend.dev>"
# PASSWORD_RESET_EXPIRES_MINUTES=60
# PASSWORD_RESET_APP_HINT="Mobil uygulamada şifre sıfırlama ekranına bu kodu girin."

# test.py — POST /auth/reset-password E2E: sunucu her forgot sonrası son kodu bu dosyaya JSON satırı yazar (üretimde kullanma)
# AIDATPANEL_E2E_RESET_LOG=/tmp/aidatpanel-reset-e2e.jsonl

# Auth rate limit (varsayılan: production=30, development=50). Çok düşükse test.py 429 alır.
# Auth brute-force limiti (15 dk pencere; başarılı istekler sayılmaz)
# Anahtar: login/register/join/forgot → e-posta/telefon; logout → userId; yoksa IP
# AUTH_RATE_LIMIT_MAX=100
# OTP gönder/doğrula (varsayılan: production=20, development=30)
# OTP_RATE_LIMIT_MAX=30

# Postman / test.py — POST /notifications/_e2e/seed + rate limit kapalı
# AIDATPANEL_E2E=1
# Genel API limiti (production: 600 / 15 dk; development: 5000)
# API_RATE_LIMIT_MAX=5000

# Firebase Push Notifications — mobil ile AYNI proje (google-services.json → project_id)
# Mobil: aidatpanel · project_number 959446516084
# FIREBASE_PROJECT_ID=aidatpanel
# Production: tek satır JSON (tırnak içinde)
# FIREBASE_SERVICE_ACCOUNT_JSON='{"type":"service_account","project_id":"aidatpanel",...}'
#
# Geliştirme — dosya yolu:
# FIREBASE_SERVICE_ACCOUNT_PATH=./aidatpanel-firebase-adminsdk-xxxxx.json
#
# YANLIŞ: başka proje (ör. aidat-panel-deneme) → messaging/mismatched-credential
#
# Teşhis (backend/ dizininden):
#   npm run verify:firebase              → credential / project_id kontrolü
#   npm run diagnose:fcm -- "<fcmToken>" → gerçek FCM gönderim testi
#   npm run test:push -- "<fcmToken>" "Başlık" "Mesaj"
# DEBUG_PUSH=1  → başarılı push console.log (production gürültüsü kapalı)

# Canlı in-app bildirim (WebSocket) — Instagram-benzeri anlık rozet/toast
REALTIME_WS_ENABLED=true

# SMS — şifre sıfırlama (sakin telefon OTP Firebase Auth Phone; bu env zorunlu değil)
# Sağlayıcı: auto (varsayılan) | twilio | netgsm
# SMS_PROVIDER=twilio
#
# --- Twilio (şifre sıfırlama SMS / legacy yönetici telefon OTP) ---
# 1) https://console.twilio.com → Account SID + Auth Token
# 2) Phone Numbers → Buy a number (SMS özellikli, trial kredisiyle ~1 numara)
# 3) Trial hesapta YALNIZCA doğrulanmış numaralara SMS gider:
#    Phone Numbers → Manage → Verified Caller IDs → +90 cep numaranızı ekleyin
# 4) Mesajda "Sent from your Twilio trial account" uyarısı görünebilir (normal)
# TWILIO_ACCOUNT_SID=ACxxxxxxxx
# TWILIO_AUTH_TOKEN=xxxxxxxx
# TWILIO_PHONE_FROM=+
# UYARI: FROM, Twilio Console'da bu hesaba ait satın alınmış numara olmalıdır.
# Kendi cep numaranızı (+90...) yazmak 21659 hatası verir.
# Legacy OTP: Twilio Verify
# Console → Verify → Services → Service SID
# TWILIO_VERIFY_SERVICE_SID=VAxxxxxxxx
#
# Test: cd backend && npm run test:sms -- 5551234567
#
# --- NetGsm (Türkiye prod şifre sıfırlama) ---
# NETGSM_USER=
# NETGSM_PASS=
# NETGSM_HEADER=AIDATPANEL

# Dekont (PDF / JPEG / PNG)
DEKONT_MAX_BYTES=10485760
DEKONT_UPLOAD_DIR=./uploads/dekonts
DEKONT_UPLOAD_RATE_MAX=10
DEKONT_AMOUNT_TOLERANCE=0.05
DEKONT_GRACE_DAYS=7
DEKONT_AI_AUTO_THRESHOLD=0.85
DEKONT_AUTO_APPLY_PAYMENT=false
# Pipeline OCR hatasında yeniden deneme sayısı (1 = retry yok)
DEKONT_PIPELINE_MAX_RETRIES=1
# Aynı anda OCR pipeline sayısı (varsayılan 1; artırırsanız CPU yükü artar)
# DEKONT_PIPELINE_CONCURRENCY=1
# OCR worker thread (false = yalnızca ana süreçte OCR)
# DEKONT_OCR_IN_WORKER=true
# DEKONT_OCR_WORKER_TIMEOUT_MS=120000
# Multer geçici upload klasörü
# DEKONT_UPLOAD_TMP_DIR=./uploads/dekonts/_tmp
# Liste uçları üst sınırı (?limit= ile düşürülebilir, varsayılan 2500)
# LIST_MAX_ROWS=2500
# Sayfalı liste varsayılan sayfa boyutu (?paginated=true veya ?cursor=)
# LIST_PAGE_SIZE=50
# FCM paralel gönderim / aidat hatırlatma paralelliği
# FCM_PUSH_CONCURRENCY=8
# DUE_REMIND_CONCURRENCY=8
# Otomatik aidat bakımı: eksik ay üretimi + PENDING→OVERDUE geçişi
# DUE_AUTO_GENERATE_ENABLED=true
# DUE_AUTO_GENERATE_INTERVAL_MS=86400000
# Yerel PostgreSQL pool (Neon adapter'da kullanılmaz)
# PG_POOL_MAX=10
DEKONT_OCR_MIN_CONFIDENCE=0.6

# RevenueCat Subscription Validation
# REVENUECAT_API_KEY=rg_xxxxxxxx
# REVENUECAT_WEBHOOK_SECRET=whsec_xxxxxxxx

# Admin Panel API (ayrı AdminUser tablosu — mobil JWT ile paylaşılmaz)
ADMIN_JWT_SECRET=your_admin_jwt_secret_minimum_32_characters_long
# ADMIN_JWT_EXPIRES_IN=15m
# ADMIN_REFRESH_EXPIRES_IN=8h
# ADMIN_ALLOWED_IPS=203.0.113.10,198.51.100.5
# ADMIN_AUTH_RATE_LIMIT_MAX=5
# ADMIN_BACKUP_DIR=./backups/admin
# Windows: PostgreSQL kurulu değilse pg_dump yolu
# PG_DUMP_PATH=C:\Program Files\PostgreSQL\16\bin\pg_dump.exe
# ADMIN_ACTIVITY_INTERVAL_MS=86400000
# Admin seed: node scripts/seed-admin.js
# ADMIN_SEED_EMAIL=admin@aidatpanel.com
# ADMIN_SEED_PASSWORD=...

# ==========================================
# Docker ile tam E2E (Postgres + API + test.py)
# ==========================================
#   cd backend && ./scripts/docker-test.sh
# API: http://127.0.0.1:4200/api/v1 — şifre sıfırlama kodu: ./e2e-data/reset.jsonl
# Durdur: docker compose down

# ==========================================
# NOTES
# ==========================================
# - Asla gerçek .env dosyasını GitHub'a push etme!
# - .gitignore'da .env zaten ignore ediliyor
# - Üretim ortamında (production) farklı değerler kullan
# - Bu repoda daha önce gerçek DATABASE_URL paylaşıldıysa Neon/DB şifresini rotate et
