<% const navActive = (p) => (p === '/' ? currentPath === '/' : currentPath === p || currentPath.startsWith(p + '/')); %>
<div class="app-shell" x-data="{ sidebarOpen: false, notifOpen: false }" @keydown.escape.window="sidebarOpen = false; notifOpen = false">
  <div class="sidebar-backdrop" :class="{ 'is-open': sidebarOpen }" @click="sidebarOpen = false" aria-hidden="true"></div>

  <aside class="sidebar" :class="{ 'is-open': sidebarOpen }" aria-label="Ana menü">
    <div class="sidebar__brand">
      <div class="sidebar__logo">AP</div>
      <div>
        <span class="sidebar__brand-text">AidatPanel</span>
        <span class="sidebar__brand-sub">Operasyon Paneli</span>
      </div>
    </div>

    <nav class="sidebar__nav">
      <div class="sidebar__section">
        <a href="/" class="sidebar__link" aria-current="<%= navActive('/') ? 'page' : 'false' %>">
          <%- include('icon', { name: 'dashboard' }) %><span class="sidebar__label">Komuta Merkezi</span>
        </a>
        <a href="/explorer" class="sidebar__link" aria-current="<%= navActive('/explorer') ? 'page' : 'false' %>">
          <%- include('icon', { name: 'users' }) %><span class="sidebar__label">Müşteri Gezgini</span>
        </a>
        <a href="/search" class="sidebar__link" aria-current="<%= navActive('/search') ? 'page' : 'false' %>">
          <%- include('icon', { name: 'search' }) %><span class="sidebar__label">Arama</span>
        </a>
      </div>

      <div class="sidebar__section">
        <span class="sidebar__section-label">İş</span>
        <a href="/growth" class="sidebar__link" aria-current="<%= navActive('/growth') ? 'page' : 'false' %>">
          <%- include('icon', { name: 'subscription' }) %><span class="sidebar__label">Büyüme & Abonelik</span>
        </a>
        <a href="/ops/dekonts" class="sidebar__link" aria-current="<%= currentPath === '/ops/dekonts' ? 'page' : 'false' %>">
          <%- include('icon', { name: 'dekont' }) %><span class="sidebar__label">Dekontlar</span>
        </a>
        <a href="/ops/tickets" class="sidebar__link" aria-current="<%= currentPath === '/ops/tickets' ? 'page' : 'false' %>">
          <%- include('icon', { name: 'ticket' }) %><span class="sidebar__label">Talepler</span>
        </a>
        <a href="/analytics" class="sidebar__link" aria-current="<%= navActive('/analytics') ? 'page' : 'false' %>">
          <%- include('icon', { name: 'analytics' }) %><span class="sidebar__label">Analitik</span>
        </a>
      </div>

      <div class="sidebar__section">
        <span class="sidebar__section-label">Sistem</span>
        <a href="/audit" class="sidebar__link" aria-current="<%= navActive('/audit') ? 'page' : 'false' %>">
          <%- include('icon', { name: 'shield' }) %><span class="sidebar__label">Denetim Kayıtları</span>
        </a>
        <% if (admin.role === 'SUPER_ADMIN') { %>
        <a href="/backups" class="sidebar__link" aria-current="<%= navActive('/backups') ? 'page' : 'false' %>">
          <%- include('icon', { name: 'backup' }) %><span class="sidebar__label">Yedekler</span>
        </a>
        <% } %>
      </div>
    </nav>

    <div class="sidebar__footer">
      <div class="sidebar__user">
        <div class="sidebar__avatar"><%= (admin.name || 'A').charAt(0).toUpperCase() %></div>
        <div class="sidebar__user-info">
          <div class="sidebar__user-name"><%= admin.name %></div>
          <div class="sidebar__user-role"><%= admin.role === 'SUPER_ADMIN' ? 'Süper Admin' : 'Destek' %></div>
        </div>
      </div>
    </div>
  </aside>

  <div class="main-wrap">
    <header class="topbar">
      <div class="topbar__left">
        <button type="button" class="menu-toggle" @click="sidebarOpen = !sidebarOpen" aria-label="Menüyü aç" :aria-expanded="sidebarOpen">
          <%- include('icon', { name: 'menu' }) %>
        </button>
        <h1 class="topbar__title"><%= title %></h1>
      </div>

      <form class="command-search" method="get" action="/search" role="search">
        <input class="command-search__input" type="search" name="q" placeholder="Müşteri ara…" aria-label="Müşteri ara">
        <span class="command-search__kbd">Enter</span>
      </form>

      <div class="topbar__actions">
        <div class="notif-root" @click.outside="notifOpen = false">
        <button type="button" class="icon-btn" @click.stop="notifOpen = !notifOpen" aria-label="Bildirimler" :aria-expanded="notifOpen">
          <%- include('icon', { name: 'bell' }) %>
          <% const unread = (typeof notifications !== 'undefined' ? notifications : []).filter(n => !n.isRead).length %>
          <% if (unread > 0) { %><span class="icon-btn__badge"><%= unread > 9 ? '9+' : unread %></span><% } %>
        </button>
        <div class="notification-dropdown" x-show="notifOpen" x-cloak>
          <div class="notification-dropdown__header">
            <span class="notification-dropdown__title">Bildirimler</span>
            <button type="button" class="btn btn--ghost btn--sm" @click="notifOpen = false" aria-label="Kapat">✕</button>
          </div>
          <% const notifs = typeof notifications !== 'undefined' ? notifications.slice(0, 8) : [] %>
          <% if (notifs.length === 0) { %>
            <div class="empty-state" style="padding:2rem 1rem">
              <p class="empty-state__title">Bildirim yok</p>
            </div>
          <% } else { %>
            <% if (unread > 0) { %>
            <div class="notification-dropdown__actions">
              <form method="post" action="/notifications/read-all" style="margin:0;display:inline">
                <button type="submit" class="btn btn--ghost btn--sm">Tümünü okundu işaretle</button>
              </form>
            </div>
            <% } %>
            <% notifs.forEach(n => { %>
              <div class="notification-item<%= !n.isRead ? ' notification-item--unread' : '' %>">
                <form method="post" action="/notifications/<%= n.id %>/read" style="margin:0;text-align:left;width:100%">
                  <button type="submit" class="btn btn--ghost" style="width:100%;height:auto;padding:0;min-height:0;justify-content:flex-start;flex-direction:column;align-items:flex-start;gap:var(--space-1)">
                    <p class="notification-item__title"><%= n.title %><% if (!n.isRead) { %> <span class="badge badge--primary" style="margin-left:4px">Yeni</span><% } %></p>
                    <p class="notification-item__body"><%= n.body %></p>
                  </button>
                </form>
              </div>
            <% }) %>
          <% } %>
        </div>
        </div>
        <span class="topbar__user-chip truncate"><%= admin.name %></span>
        <form action="/auth/logout" method="post" style="margin:0">
          <button type="submit" class="btn btn--secondary btn--sm" title="Çıkış">
            <%- include('icon', { name: 'logout' }) %>
          </button>
        </form>
      </div>
    </header>

    <main class="content">
      <%- content %>
    </main>
  </div>
</div>

<style>[x-cloak]{display:none!important}</style>
