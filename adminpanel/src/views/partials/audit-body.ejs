<%- include('flash') %>
<%- include('page-header', { title: 'Denetim Kayıtları', description: 'Tüm hassas admin işlemlerinin iz kaydı. PII içermez.' }) %>

<div class="filter-panel" x-data="{ open: false }" :class="{ 'is-open': open }">
  <button type="button" class="filter-panel__toggle mobile-only" @click="open = !open"><span>Filtreler</span><span>▼</span></button>
  <form class="filter-panel__body" method="get" action="/audit">
    <div class="form-group" style="margin:0;min-width:200px">
      <label for="action">İşlem türü</label>
      <select class="form-control" id="action" name="action">
        <option value="">Tümü</option>
        <% const actions = ['ADMIN_LOGIN','ADMIN_LOGOUT','USER_VIEW','PASSWORD_RESET','ACCOUNT_DELETE','SUBSCRIPTION_GRANT','PROMO_CREATE','NOTIFICATION_BROADCAST','BACKUP_CREATE','BACKUP_DOWNLOAD_TOKEN']; %>
        <% actions.forEach(a => { %>
        <option value="<%= a %>" <%= filters.action === a ? 'selected' : '' %>><%= a %></option>
        <% }) %>
      </select>
    </div>
    <button type="submit" class="btn btn--primary">Filtrele</button>
  </form>
</div>

<% if (!logs.length) { %>
<div class="card"><div class="empty-state"><p class="empty-state__title">Kayıt bulunamadı</p></div></div>
<% } else { %>
<div class="data-table-wrap">
  <table class="data-table">
    <thead>
      <tr><th>Tarih</th><th>Admin</th><th>İşlem</th><th>Hedef</th><th>IP</th></tr>
    </thead>
    <tbody>
      <% logs.forEach(log => { %>
      <tr>
        <td class="text-secondary" style="white-space:nowrap"><%= new Date(log.createdAt).toLocaleString('tr-TR') %></td>
        <td><strong><%= log.admin?.name || '—' %></strong><br><span class="text-muted" style="font-size:var(--font-size-xs)"><%= log.admin?.email || '' %></span></td>
        <td><span class="badge badge--primary"><%= log.action %></span></td>
        <td class="text-secondary">
          <% if (log.targetType) { %><%= log.targetType %><% if (log.targetId) { %><br><code style="font-size:0.7rem"><%= log.targetId.slice(0,8) %>…</code><% } %><% } else { %>—<% } %>
        </td>
        <td class="text-muted"><%= log.ipAddress || '—' %></td>
      </tr>
      <% }) %>
    </tbody>
  </table>
</div>

<div class="data-cards">
  <% logs.forEach(log => { %>
  <div class="data-card">
    <div class="data-card__header">
      <h3 class="data-card__title"><%= log.action %></h3>
      <span class="badge badge--muted"><%= log.admin?.name %></span>
    </div>
    <p class="data-card__meta"><%= new Date(log.createdAt).toLocaleString('tr-TR') %></p>
    <% if (log.targetType) { %><p class="data-card__meta"><%= log.targetType %> · <%= log.targetId ? log.targetId.slice(0,12) + '…' : '' %></p><% } %>
  </div>
  <% }) %>
</div>
<% } %>

<%- include('./pagination', { pagination, basePath: '/audit', query: filters }) %>
