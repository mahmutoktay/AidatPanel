<%- include('flash') %>

<div class="kpi-grid">
  <div class="card card--kpi card--kpi--blue">
    <div class="card__top">
      <span class="card__label">Toplam Üye</span>
      <div class="card__icon"><%- include('icon', { name: 'users' }) %></div>
    </div>
    <p class="card__value"><%= kpis.userCount ?? '—' %></p>
  </div>
  <div class="card card--kpi card--kpi--green">
    <div class="card__top">
      <span class="card__label">Yönetici</span>
      <div class="card__icon"><%- include('icon', { name: 'shield' }) %></div>
    </div>
    <p class="card__value"><%= kpis.managerCount ?? '—' %></p>
  </div>
  <div class="card card--kpi card--kpi--purple">
    <div class="card__top">
      <span class="card__label">Aktif Abonelik</span>
      <div class="card__icon"><%- include('icon', { name: 'subscription' }) %></div>
    </div>
    <p class="card__value"><%= kpis.activeSubs ?? '—' %></p>
  </div>
  <div class="card card--kpi card--kpi--amber">
    <div class="card__top">
      <span class="card__label">7 Gün İçinde Biten</span>
      <div class="card__icon"><%- include('icon', { name: 'chart' }) %></div>
    </div>
    <p class="card__value"><%= kpis.expiringSoon ?? '—' %></p>
  </div>
</div>

<div class="chart-grid mb-6">
  <div class="card">
    <div class="card__header">
      <div>
        <h3 class="card__title">Dekont Durumları</h3>
        <p class="card__subtitle">Tüm binalardaki dekont dağılımı</p>
      </div>
    </div>
    <div class="chart-container">
      <canvas id="dekontChart"></canvas>
    </div>
  </div>
  <div class="card">
    <div class="card__header">
      <div>
        <h3 class="card__title">Günlük Aktif Kullanıcı</h3>
        <p class="card__subtitle">Son 14 gün, role göre</p>
      </div>
    </div>
    <div class="chart-container">
      <canvas id="dauChart"></canvas>
    </div>
  </div>
</div>

<div class="card">
  <div class="card__header">
    <div>
      <h3 class="card__title">Hızlı İşlemler</h3>
      <p class="card__subtitle">Sık kullanılan yönetim ekranları</p>
    </div>
  </div>
  <div class="quick-actions">
    <a href="/users" class="quick-action">
      <div class="quick-action__icon"><%- include('icon', { name: 'search' }) %></div>
      <span class="quick-action__label">Üye Ara</span>
      <span class="quick-action__desc">Kullanıcı listesi ve detay</span>
    </a>
    <a href="/subscriptions" class="quick-action">
      <div class="quick-action__icon"><%- include('icon', { name: 'subscription' }) %></div>
      <span class="quick-action__label">Abonelikler</span>
      <span class="quick-action__desc">Plan ve promo yönetimi</span>
    </a>
    <a href="/reports/dekonts" class="quick-action">
      <div class="quick-action__icon"><%- include('icon', { name: 'dekont' }) %></div>
      <span class="quick-action__label">Dekont Raporu</span>
      <span class="quick-action__desc">OCR ve eşleştirme durumu</span>
    </a>
    <a href="/analytics" class="quick-action">
      <div class="quick-action__icon"><%- include('icon', { name: 'analytics' }) %></div>
      <span class="quick-action__label">Analitik</span>
      <span class="quick-action__desc">DAU/MAU ve bildirimler</span>
    </a>
    <a href="/audit" class="quick-action">
      <div class="quick-action__icon"><%- include('icon', { name: 'shield' }) %></div>
      <span class="quick-action__label">Denetim Kayıtları</span>
      <span class="quick-action__desc">Admin işlem geçmişi</span>
    </a>
  </div>
</div>

<script>
  (function () {
    const chartDefaults = {
      color: '#a1a1aa',
      borderColor: '#27272a',
    };
    const dekontData = <%- JSON.stringify(dekontSummary.byStatus || []) %>;
    const dauData = <%- JSON.stringify(activeUsers || []) %>;
    if (typeof Chart !== 'undefined') {
      Chart.defaults.color = chartDefaults.color;
      Chart.defaults.borderColor = chartDefaults.borderColor;
    }
    if (typeof Chart !== 'undefined' && dekontData.length) {
      new Chart(document.getElementById('dekontChart'), {
        type: 'doughnut',
        data: {
          labels: dekontData.map(d => d.status),
          datasets: [{ data: dekontData.map(d => d.count), backgroundColor: ['#6366f1','#22c55e','#f59e0b','#ef4444','#8b5cf6','#64748b'], borderWidth: 0 }]
        },
        options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { position: 'bottom', labels: { padding: 16, usePointStyle: true } } }, cutout: '65%' }
      });
    }
    if (typeof Chart !== 'undefined' && dauData.length) {
      const labels = [...new Set(dauData.map(d => d.date))];
      new Chart(document.getElementById('dauChart'), {
        type: 'line',
        data: {
          labels,
          datasets: [
            { label: 'Yönetici', data: labels.map(l => (dauData.find(d => d.date === l && d.role === 'MANAGER') || {}).activeUsers || 0), borderColor: '#6366f1', backgroundColor: 'rgba(99,102,241,0.1)', fill: true, tension: 0.35, pointRadius: 3 },
            { label: 'Sakin', data: labels.map(l => (dauData.find(d => d.date === l && d.role === 'RESIDENT') || {}).activeUsers || 0), borderColor: '#22c55e', backgroundColor: 'rgba(34,197,94,0.1)', fill: true, tension: 0.35, pointRadius: 3 }
          ]
        },
        options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { position: 'bottom', labels: { usePointStyle: true } } }, scales: { y: { beginAtZero: true, grid: { color: '#27272a' } }, x: { grid: { display: false } } } }
      });
    }
  })();
</script>
