<%- include('flash') %>
<%- include('page-header', { title: 'Arama', description: 'Yönetici ve sakinleri ad, e-posta veya telefon ile bulun.' }) %>

<form method="get" class="filter-panel__body mb-6" style="display:flex;gap:var(--space-3);flex-wrap:wrap;padding:var(--space-4);background:var(--color-bg-surface);border:1px solid var(--color-border);border-radius:var(--radius-lg)">
  <div class="form-group" style="margin:0;flex:1;min-width:200px">
    <label for="q">Arama</label>
    <input class="form-control" id="q" name="q" value="<%= filters.q || '' %>" placeholder="Ad, e-posta, telefon" autofocus>
  </div>
  <div class="form-group" style="margin:0;min-width:130px">
    <label for="role">Rol</label>
    <select class="form-control" id="role" name="role">
      <option value="">Tümü</option>
      <option value="MANAGER" <%= filters.role === 'MANAGER' ? 'selected' : '' %>>Yönetici</option>
      <option value="RESIDENT" <%= filters.role === 'RESIDENT' ? 'selected' : '' %>>Sakin</option>
    </select>
  </div>
  <% if (!filters.role || filters.role === 'MANAGER') { %>
  <div class="form-group" style="margin:0;min-width:140px">
    <label for="hasSubscription">Abonelik</label>
    <select class="form-control" id="hasSubscription" name="hasSubscription">
      <option value="">Tümü</option>
      <option value="true" <%= filters.hasSubscription === 'true' ? 'selected' : '' %>>Var</option>
      <option value="false" <%= filters.hasSubscription === 'false' ? 'selected' : '' %>>Yok</option>
    </select>
  </div>
  <% } %>
  <div class="form-group" style="margin:0;display:flex;align-items:flex-end">
    <button type="submit" class="btn btn--primary">Ara</button>
  </div>
</form>

<% if (filters.q || filters.role) { %>
  <% if (managers.length) { %>
  <h3 class="section-title">Yöneticiler</h3>
  <div class="data-row-list mb-6">
    <% managers.forEach(u => { %>
    <a href="/users/<%= u.id %>" class="data-row">
      <div class="data-row__avatar"><%= (u.name || '?').charAt(0) %></div>
      <div class="data-row__body">
        <p class="data-row__title"><%= u.name %></p>
        <p class="data-row__meta"><%= u.email || '—' %> · <%= u.phone || '—' %> · <%= u.buildingCount || 0 %> bina</p>
      </div>
      <div class="data-row__end">
        <% if (u.subscription) { %><span class="badge badge--<%= u.subscription.status === 'ACTIVE' ? 'success' : 'warning' %>"><%= labels.SUBSCRIPTION_STATUS_TR[u.subscription.status] || u.subscription.status %></span><% } %>
        <span class="data-row__chevron">›</span>
      </div>
    </a>
    <% }) %>
  </div>
  <% } %>

  <% if (residents.length) { %>
  <h3 class="section-title">Sakinler</h3>
  <div class="data-row-list mb-6">
    <% residents.forEach(r => { %>
    <a href="/users/<%= r.id || r.userId || '' %>" class="data-row">
      <div class="data-row__avatar"><%= (r.name || '?').charAt(0) %></div>
      <div class="data-row__body">
        <p class="data-row__title"><%= r.name %></p>
        <p class="data-row__meta"><%= r.email || '—' %> · <%= r.phone || '—' %> · <%= r.apartment?.building?.name || '—' %> / Daire <%= r.apartment?.number || '—' %></p>
      </div>
      <div class="data-row__end"><span class="data-row__chevron">›</span></div>
    </a>
    <% }) %>
  </div>
  <% } %>

  <% if (!managers.length && !residents.length) { %>
  <div class="card"><div class="empty-state"><p class="empty-state__title">Sonuç bulunamadı</p></div></div>
  <% } %>
<% } else { %>
  <div class="card"><div class="empty-state"><p class="empty-state__title">Aramaya başlayın</p><p>Üstteki kutuya ad, e-posta veya telefon yazın.</p></div></div>
<% } %>
