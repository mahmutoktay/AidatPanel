<!DOCTYPE html>
<html lang="tr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Giriş — AidatPanel Admin</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/layout.css">
  <link rel="stylesheet" href="/css/components.css">
  <link rel="stylesheet" href="/css/patterns.css">
</head>
<body>
  <div class="login-page">
    <div class="login-card">
      <div class="login-card__logo">
        <div class="sidebar__logo" style="width:44px;height:44px;font-size:1rem">AP</div>
        <div>
          <h1>AidatPanel</h1>
          <p class="login-card__subtitle" style="margin:0">Operasyon paneline giriş yapın</p>
        </div>
      </div>
      <% if (error) { %><div class="alert alert--error"><%= error %></div><% } %>
      <form method="post" action="/auth/login">
        <div class="form-group">
          <label for="email">E-posta adresi</label>
          <input class="form-control" type="email" id="email" name="email" required autocomplete="username" placeholder="admin@aidatpanel.com">
        </div>
        <div class="form-group">
          <label for="password">Şifre</label>
          <input class="form-control" type="password" id="password" name="password" required autocomplete="current-password" placeholder="••••••••">
        </div>
        <button type="submit" class="btn btn--primary btn--block">Giriş Yap</button>
      </form>
    </div>
  </div>
</body>
</html>
